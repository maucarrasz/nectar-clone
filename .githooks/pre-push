#!/bin/bash
# Escáner de secretos pre-push (regla del owner 2026-10-25). Complementa a pre-commit:
# bloquea el push si ALGÚN commit que va a subir contiene un patrón de secreto.
# Coincidencias truncadas; nunca imprime el secreto completo.
PAT_CLAVES='fc-[A-Za-z0-9_-]{20}|sk-[A-Za-z0-9_-]{20}|ghp_[A-Za-z0-9]{20}|github_pat_[A-Za-z0-9_]{20}|AIza[0-9A-Za-z_-]{30}|xox[baprs]-[0-9A-Za-z-]{10}|eyJ[A-Za-z0-9_-]{10}\.[A-Za-z0-9_-]{10}\.|-----BEGIN [A-Z ]*PRIVATE KEY-----'
PAT_ASIGNACION='(api[_-]?key|secret|password|token)["'"'"']?[[:space:]]*[:=][[:space:]]*["'"'"'][^"'"'"']{16,}["'"'"']'
falla=0
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue
  if [ "$remote_sha" = "0000000000000000000000000000000000000000" ]; then
    rango="$local_sha --not --remotes"
  else
    rango="$remote_sha..$local_sha"
  fi
  OLDEST=$(git rev-list $rango 2>/dev/null | tail -1)
  [ -z "$OLDEST" ] && continue
  if git rev-parse --verify -q "$OLDEST^" >/dev/null 2>&1; then BASE="$OLDEST^"; else BASE=4b825dc642cb6eb9a060e54bf8d69288fbee4904; fi
  DIFF=$(git diff -U0 --no-color "$BASE" "$local_sha" -- . ':(exclude).githooks/*' 2>/dev/null | grep '^+' | grep -v '^+++' || true)
  [ -z "$DIFF" ] && continue
  HIT=""
  echo "$DIFF" | grep -Eiq "$PAT_CLAVES" && HIT="$PAT_CLAVES"
  if [ -z "$HIT" ] && echo "$DIFF" | grep -Ei "$PAT_ASIGNACION" | grep -Eivq "process\.env|os\.environ|getenv|ENV\[|import\.meta\.env"; then HIT="$PAT_ASIGNACION"; fi
  if [ -n "$HIT" ]; then
    falla=1
    echo "PUSH BLOQUEADO: posible secreto en commits por subir ($local_ref)."
    echo "$DIFF" | grep -Ein "$HIT" | sed -E 's/([A-Za-z0-9_.-]{6})[A-Za-z0-9_.-]{8,}/\1…/g' | cut -c1-80 | head -5
  fi
done
if [ $falla -eq 1 ]; then
  echo "Los secretos van en el vault o en variables de entorno. Corrige los commits antes de subir."
  exit 1
fi
exit 0
